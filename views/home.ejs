<link rel="stylesheet" href="/styles.css">

<div class="container">

<header class="hero">
    <h1>🏠 Club House</h1>

    <% if (user) { %>
        <p class="welcome">
            Welcome back, <strong><%= user.first_name %></strong>
        </p>

        <div class="nav-links">
            <a class="btn" href="/messages/new">Create Message</a>

            <% if (!user.is_member) { %>
                <a class="btn secondary" href="/join">Join Club</a>
            <% } %>

            <% if (!user.is_admin) { %>
                <a class="btn secondary" href="/admin">Become Admin</a>
            <% } %>

            <a class="btn danger" href="/logout">Logout</a>
        </div>

    <% } else { %>

        <div class="nav-links">
            <a class="btn" href="/login">Login</a>
            <a class="btn secondary" href="/signup">Sign Up</a>
        </div>

    <% } %>
</header>

<% if (messages.length === 0) { %>
    <div class="empty-state">
        <h2>No messages yet</h2>
        <p>Be the first person to post something.</p>
    </div>
<% } %>

<% messages.forEach(message => { %>

    <div class="message-card">

        <h3 class="message-title">
            <%= message.title %>
        </h3>

        <p class="message-content">
            <%= message.text %>
        </p>

        <% if (user && user.is_member) { %>
            <p class="message-meta">
                By <%= message.first_name %> <%= message.last_name %>
                • <%= new Date(message.created_at).toLocaleString() %>
            </p>
        <% } %>

        <% if (user && user.is_admin) { %>
            <form
                method="POST"
                action="/messages/<%= message.id %>/delete"
            >
                <button class="delete-btn" type="submit">
                    Delete Message
                </button>
            </form>
        <% } %>

    </div>

<% }) %>

</div>
